# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ───────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js

# ── Production build ───────────────────────────────────────────────────────────
/build
/dist
/out
/.next
/.cache
/.temp
/.parcel-cache

# ── Testing ───────────────────────────────────────────────────────────────────
/coverage
/jest-cache
/jest-junit.xml
/nyc_output
/tsconfig.tsbuildinfo

# ── Environment ───────────────────────────────────────────────────────────────
# CRA가 사용하는 env
.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Icon?
._*

# ── IDE / Editor ───────────────────────────────────────────────────────────────
# VSCode
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Mac
*.DS_Store

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# ── Miscellaneous ─────────────────────────────────────────────────────────────
# Temporary system files
*.swp
*.swo
*~
# lockfiles
package-lock.json
yarn.lock
# (Lockfile은 팀 정책에 따라 커밋할 수도 있습니다.)

# favicon build outputs, service workers, etc.
/public/precache-manifest.*.js
/service-worker.js

# log files
logs/
*.log

# Turborepo
/.turbo

# pnpm
.pnpm-debug.log

# Docker
*.env.*.gpg
